/* tube: Catppuccin Mocha, matching FreeTube's theme */
* {
    base:     #1e1e2e;
    surface0: #313244;
    surface1: #45475a;
    text:     #cdd6f4;
    subtext:  #a6adc8;
    mauve:    #cba6f7;
    green:    #a6e3a1;

    background-color: transparent;
    text-color:       @text;
    font:             "IBM Plex Sans 12";
}

window {
    width:            960px;
    background-color: @base;
    border:           2px;
    border-color:     @surface1;
    border-radius:    14px;
    padding:          16px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing:  12px;
}

inputbar {
    children:         [ prompt, entry ];
    spacing:          12px;
    padding:          10px 14px;
    background-color: @surface0;
    border-radius:    10px;
}

prompt { text-color: @mauve; }

/* normal mode: shows the current filter in place of the text box */
textbox-filter {
    expand:         true;
    vertical-align: 0.5;
    text-color:     @subtext;
}

/* vim-style NORMAL / INSERT badge; tube sets the text and insert colour */
textbox-mode {
    expand:           false;
    vertical-align:   0.5;
    padding:          2px 8px;
    border-radius:    6px;
    background-color: @mauve;
    text-color:       @base;
    font:             "IBM Plex Mono Bold 9";
}

entry {
    placeholder:       "filter, or type to search YouTube";
    placeholder-color: @subtext;
    cursor:            text;
}

message { padding: 0 4px; }

textbox {
    text-color: @subtext;
    font:       "IBM Plex Sans 9";
}

listview {
    lines:        8;
    fixed-height: true;
    scrollbar:    false;
    spacing:      2px;
}

element {
    children:      [ element-icon, element-text ];
    padding:       6px;
    spacing:       14px;
    border-radius: 10px;
}

element selected.normal { background-color: @surface0; }

/* 16:9 thumbnails instead of square icons. rofi sizes every row from an
   empty placeholder row, so rows are as tall as `size` even though the
   thumbnail is only 9/16 of it. */
element-icon {
    size:    104px;
    squared: false;
}

element-text { vertical-align: 0.5; }
